{
  "name": "aact-hrms",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "env:local": "node scripts/local-env.mjs",
    "local:setup": "supabase start && node scripts/local-env.mjs",
    "seed:gen": "python scripts/gen-seed.py",
    "db:test": "bash scripts/local-db-reset.sh && psql -h ${PGHOST:-/tmp} -p ${PGPORT:-5433} -U postgres -d aact_test -q -v ON_ERROR_STOP=1 -f tests/db/10_priority1.sql -f tests/db/20_phase2.sql"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "supabase": "2.121.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild": true,
    "supabase": true
  }
}
