# deploy/.env — company server settings (copy to deploy/.env; install.sh fills the secrets).
# NEVER commit deploy/.env. Real employee data lives only on this server.

DOMAIN=hr.aact.om                 # address staff will open
PUBLIC_URL=https://hr.aact.om     # same, with https
ENV_LABEL=                        # leave empty for production (TEST shows a banner)
APP_VERSION=1.7.0

INSTALL_DIR=/opt/aact-hrms
CERT_DIR=/opt/aact-hrms/certs     # fullchain.pem + privkey.pem (company certificate or self-signed)
BACKUP_DIR=/opt/aact-hrms/backups
BACKUP_KEEP_DAYS=30
BACKUP_OFFSITE=                   # optional: rsync target, e.g. backup@10.0.0.20:/srv/aact-hrms

# Filled by install.sh from supabase/.env (do not type by hand)
ANON_KEY=

# Outgoing e-mail for password resets and invitations (company SMTP / Microsoft 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=hrms@aact.om
SMTP_PASS=
SMTP_ADMIN_EMAIL=hrms@aact.om
SMTP_SENDER_NAME="AACT HRMS"

# HR notification e-mails through Microsoft Graph (optional; see docs/ENVIRONMENTS.md → "E-mail through Microsoft 365")
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=hr-notifications@aact.om
MAIL_CRON_SECRET=                 # generated by install.sh when empty
