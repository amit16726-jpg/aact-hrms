# Phone apps (Android / iPhone). Copy to .env.mobile.local and fill in, then: npm run mobile:sync
# The address must be HTTPS and reachable from the phones (public address or company VPN).
# Company server:  VITE_SUPABASE_URL=https://hr.aact.om      (anon key from /opt/aact-hrms/supabase/.env → ANON_KEY)
# Cloud test site: VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co and VITE_ENV_LABEL=TEST
VITE_SUPABASE_URL=https://hr.aact.om
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_ENV_LABEL=
